{
  "openapi": "3.0.3",
  "info": {
    "title": "Portfolio Teia Criativa API",
    "version": "1.0.0",
    "description": "Documentação OpenAPI gerada a partir dos arquivos `*_doc.py` de cada rota. Para documentar uma rota nova, crie apenas `src/modules/<rota>/app/<rota>_doc.py`."
  },
  "paths": {
    "/delete-user": {
      "delete": {
        "summary": "Deleta um usuário",
        "description": "Remove o usuário pelo user_id (UUID em string).",
        "tags": [
          "users"
        ],
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteUserResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request — parâmetros inválidos ou ausentes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found — recurso não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteUserRequest"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DeleteUserRequest": {
        "properties": {
          "user_id": {
            "description": "UUID do usuário a deletar",
            "examples": [
              "af852f40-0135-406d-b5d7-7ed5dce9bc8e"
            ],
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id"
        ],
        "title": "DeleteUserRequest",
        "type": "object"
      },
      "DeleteUserResponse": {
        "properties": {
          "user_id": {
            "description": "UUID do usuário deletado",
            "title": "User Id",
            "type": "string"
          },
          "email": {
            "description": "Email do usuário deletado",
            "title": "Email",
            "type": "string"
          },
          "role": {
            "description": "Role do usuário (Admin | User)",
            "title": "Role",
            "type": "string"
          },
          "message": {
            "description": "Mensagem de confirmação",
            "examples": [
              "the user was deleted successfully"
            ],
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "email",
          "role",
          "message"
        ],
        "title": "DeleteUserResponse",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "Resposta padrão de erro das rotas (body string no HTTP codes atuais).",
        "properties": {
          "message": {
            "description": "Mensagem de erro retornada pela API",
            "examples": [
              "Field user_id is missing"
            ],
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "ErrorResponse",
        "type": "object"
      }
    }
  }
}
